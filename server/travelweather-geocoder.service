[Unit]
Description=TravelWeather address proxy
After=network-online.target
Wants=network-online.target

[Service]
User=travelweather
Group=travelweather
WorkingDirectory=/opt/travelweather
EnvironmentFile=/etc/travelweather/geocoder.env
ExecStart=/usr/bin/python3 /opt/travelweather/geocoder.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
